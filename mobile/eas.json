      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "production"
      },
      "ios": {
        "appleId": "hashedalrajhi@gmail.com",
        "ascApiKeyId": "APPLE_STORE_CONNECT_KEY_ID",
        "ascApiKeyIssuerId": "APPLE_STORE_CONNECT_ISSUER_ID",
        "ascApiKeyPath": "./AuthKey_APPLE_STORE_CONNECT.p8"
      }
    }
  }
}
