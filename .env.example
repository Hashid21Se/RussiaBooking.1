JWT_REFRESH_SECRET=

# Social Auth Credentials
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# Payment Gateway Secrets (Mada, Tap, Tamara, SBP Mir)
TAP_API_KEY=
TAMARA_API_KEY=
HMAC_WEBHOOK_SECRET=
SBP_MERCHANT_PRIVATE_KEY=
