# AI Studio runtime variables
GEMINI_API_KEY=
APP_URL=

# Database & Cache Providers
DATABASE_URL=
REDIS_URL=

# Secret Manager Provider ('GCP_SECRET_MANAGER' | 'AWS_SECRETS_MANAGER' | 'HASHICORP_VAULT' | 'ENV_SECURE')
